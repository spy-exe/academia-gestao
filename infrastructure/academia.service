[Unit]
Description=Cadência — gestão de academia
After=network-online.target postgresql.service
Wants=network-online.target
[Service]
User=academia-app
Group=academia-app
WorkingDirectory=/var/lib/academia
EnvironmentFile=/etc/academia/app.env
ExecStart=/usr/bin/java -Xms128m -Xmx384m -Duser.timezone=America/Sao_Paulo -jar /opt/academia/current/backend.jar
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/academia
UMask=0077
[Install]
WantedBy=multi-user.target
